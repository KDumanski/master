server {
    listen 80;
    listen [::]:80;
    server_name starkproductiongroup.nyc www.starkproductiongroup.nyc;
    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; default_type "text/plain"; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name starkproductiongroup.nyc www.starkproductiongroup.nyc;
    ssl_certificate /etc/letsencrypt/live/starkproductiongroup.nyc/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/starkproductiongroup.nyc/privkey.pem;
    root /var/www/stark;
    index index.html;
    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; default_type "text/plain"; }
    location / { try_files $uri $uri/ =404; }
}
